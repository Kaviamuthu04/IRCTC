void allocateSeat(char seatNo[20])
{
    int coach;
    int seat;

    do
    {
        coach = (rand() % 10) + 1;
        seat = (rand() % 72) + 1;
        (void)snprintf(seatNo, 20, "S%d-%d", coach, seat);
    } while (seatExists(seatNo) != 0);
}

void promoteWaitlistPassenger(int cancelledTrainNo)
{
    FILE *wf;
    FILE *temp;
    char firstRecord[500] = "";
    char line[500];
    int found = 0;

    wf = fopen(WAITLIST_FILE, "r");
    if (wf == NULL)
    {
        (void)printf("Waitlist Empty\n");
        return;
    }
    temp = fopen(WAITLIST_TMP_FILE, "w");
    if (temp == NULL)
    {
        (void)fclose(wf);
        (void)printf("Temp File Error\n");
        return;
    }

    while (fgets(line, sizeof(line), wf) != NULL)
    {
        int waitlistTrainNo;

        (void)sscanf(line, "%*d|%*[^|]|%*d|%*[^|]|%*[^|]|%d|", &waitlistTrainNo);

        if ((found == 0) && (waitlistTrainNo == cancelledTrainNo))
        {
            (void)strncpy(firstRecord, line, sizeof(firstRecord) - 1U);
            firstRecord[sizeof(firstRecord) - 1U] = '\0';
            found = 1;
            continue;
        }
        (void)fputs(line, temp);
    }
    (void)fclose(wf);
    (void)fclose(temp);

    if (found == 0)
    {
        (void)remove(WAITLIST_TMP_FILE);
        (void)printf("No Matching Waitlist Passenger Found\n");
        return;
    }

    (void)remove(WAITLIST_FILE);
    (void)rename(WAITLIST_TMP_FILE, WAITLIST_FILE);

    {
        FILE *rf;
        char seatNo[20];
        int pnr = 0;
        float fare = (float)ADULT_FARE;
        char *pos;

        allocateSeat(seatNo);
        firstRecord[strcspn(firstRecord, "\n")] = '\0';
        (void)sscanf(firstRecord, "%d|", &pnr);

        pos = strstr(firstRecord, "WAITLIST");
        if (pos != NULL)
        {
            *pos = '\0';
        }

        rf = fopen(RESERVATION_FILE, "a");
        if (rf != NULL)
        {
            (void)fprintf(rf, "%s%s|PAYMENT_PENDING\n", firstRecord, seatNo);
            (void)fclose(rf);
        }

        sendPromotionNotification(pnr);
        (void)printf("\n=================================\n");
        (void)printf("WAITLIST PASSENGER PROMOTED\n");
        (void)printf("=================================\n");
        (void)printf("PNR Number  : %d\n", pnr);
        (void)printf("Seat Number : %s\n", seatNo);
        (void)printf("Fare Amount : %.2f\n", (double)fare);
        (void)printf("Status      : PAYMENT_PENDING\n");
        (void)printf("Please Complete Payment\n");
        (void)printf("=================================\n");
    }
}

