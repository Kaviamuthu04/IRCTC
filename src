void *memoryAllocate(size_t size)
{
    void *ptr;

    if (size == 0U)
    {
        return NULL;
    }

    ptr = malloc(size);
    if (ptr == NULL)
    {
        (void)fprintf(stderr, "ERROR: memory allocation of %zu bytes failed\n", size);
    }
    return ptr;
}

void memoryRelease(void *ptr)
{
    if (ptr != NULL)
    {
        free(ptr);
    }
}

long getAvailableMemoryKb(void)
{
    FILE *fp;
    char line[256];
    long memAvailableKb = -1L;

    fp = fopen("/proc/meminfo", "r");
    if (fp == NULL)
    {
        return -1L;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (strncmp(line, "MemAvailable:", 13) == 0)
        {
            if (sscanf(line, "MemAvailable: %ld", &memAvailableKb) != 1)
            {
                memAvailableKb = -1L;
            }
            break;
        }
    }
    (void)fclose(fp);
    return memAvailableKb;
}

MemoryStatus classifyMemory(long availableKb)
{
    MemoryStatus status;

    if (availableKb < 0L)
    {
        status = MEM_STATUS_CRITICAL; /* fail safe: unknown = treat as critical */
    }
    else if (availableKb < (long)MEMORY_CRITICAL)
    {
        status = MEM_STATUS_CRITICAL;
    }
    else if (availableKb < (long)MEMORY_WARNING)
    {
        status = MEM_STATUS_WARNING;
    }
    else
    {
        status = MEM_STATUS_HEALTHY;
    }
    return status;
}

static const char *memoryStatusLabel(MemoryStatus status)
{
    const char *label;

    switch (status)
    {
        case MEM_STATUS_CRITICAL:
            label = "CRITICAL";
            break;
        case MEM_STATUS_WARNING:
            label = "WARNING";
            break;
        case MEM_STATUS_HEALTHY:
            label = "HEALTHY";
            break;
        default:
            label = "UNKNOWN";
            break;
    }
    return label;
}

void addUserToQueue(const char *username)
{
    FILE *fp;

    if (username == NULL)
    {
        return;
    }

    fp = fopen(QUEUE_FILE, "a");
    if (fp == NULL)
