    (void)fclose(fp);
    return count;
}

void showOOMDashboard(void)
{
    long availableKb;
    int queuedUsers;
    int oomWarnings;
    MemoryStatus status;

    availableKb = getAvailableMemoryKb();
    queuedUsers = countQueuedUsers();
    oomWarnings = countOOMWarnings();
    status = classifyMemory(availableKb);

    (void)printf("\n=================================\n");
    (void)printf("          OOM DASHBOARD\n");
    (void)printf("=================================\n");
    (void)printf("Available Memory : %ld KB\n", availableKb);
    (void)printf("Memory Status    : %s\n", memoryStatusLabel(status));
    (void)printf("Queued Users     : %d\n", queuedUsers);
    (void)printf("OOM Warnings     : %d\n", oomWarnings);
    (void)printf("Load Shedding    : %s\n",
                 (status == MEM_STATUS_CRITICAL) ? "ACTIVE" : "INACTIVE");
    (void)printf("=================================\n");
}

void runOOMAnalysis(void)
{
    long availableKb;
    MemoryStatus status;

    (void)printf("\n=================================\n");
    (void)printf("        OOM ANALYSIS\n");
    (void)printf("=================================\n");

    availableKb = getAvailableMemoryKb();
    status = classifyMemory(availableKb);

    (void)printf("Available Memory : %ld KB\n", availableKb);
    (void)printf("Memory Status    : %s\n", memoryStatusLabel(status));

    switch (status)
    {
        case MEM_STATUS_CRITICAL:
            logOOMEvent();
            addUserToQueue("BOOKING_REQUEST");
            (void)printf("Action Taken     : USER QUEUED\n");
            (void)printf("Load Shedding    : ACTIVE\n");
            break;
        case MEM_STATUS_WARNING:
            logOOMEvent();
            (void)printf("Action Taken     : MONITORING\n");
            (void)printf("Load Shedding    : INACTIVE\n");
            break;
        case MEM_STATUS_HEALTHY:
        default:
            (void)printf("Action Taken     : NONE\n");
            (void)printf("Load Shedding    : INACTIVE\n");
            break;
    }

    (void)printf("\n=================================\n");
    (void)printf("      OOM ANALYSIS REPORT\n");
    (void)printf("=================================\n");
    (void)printf("Queued Users     : %d\n", countQueuedUsers());
    (void)printf("OOM Warnings     : %d\n", countOOMWarnings());
    (void)printf("Status           : ANALYSIS COMPLETED\n");
    (void)printf("=================================\n");
}


