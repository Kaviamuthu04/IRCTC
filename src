void bookTicket(void)
{
    int pnr;
    int passengerCount = 0;
    int bookedSeats = 0;
    int confirmedCount = 0;
    int waitlistCount = 0;
    float totalFare = 0.0f;
    char source[50];
    char destination[50];
    char journeyDate[20];
    Train train;
    FILE *fp;
    Passenger *passengers;
    int i;

    fp = fopen(RESERVATION_FILE, "a");
    if (fp == NULL)
    {
        (void)printf("Reservation File Error\n");
        return;
    }

    (void)printf("\n===== BOOK TICKET =====\n");
    (void)printf("Source : ");
    if (scanf(" %49[^\n]", source) != 1) { (void)fclose(fp); return; }
    (void)printf("Destination : ");
    if (scanf(" %49[^\n]", destination) != 1) { (void)fclose(fp); return; }
    (void)printf("Journey Date (DD-MM-YYYY) : ");
    if (scanf("%19s", journeyDate) != 1) { (void)fclose(fp); return; }

    if (findTrainByRoute(source, destination, &train) == 0)
    {
        (void)printf("No Train Available\n");
        (void)fclose(fp);
        return;
    }

    (void)printf("\nTrain No      : %d\n", train.trainNo);
    (void)printf("Train Name    : %s\n", train.trainName);
    (void)printf("AvailableSeat : %d\n", train.availableSeats);
    (void)printf("\nNumber Of Passengers : ");
    if (scanf("%d", &passengerCount) != 1)
    {
        (void)fclose(fp);
        return;
    }
    if (passengerCount <= 0)
    {
        (void)printf("Invalid Passenger Count\n");
        (void)fclose(fp);
        return;
    }

    if ((train.availableSeats > 0) && (passengerCount > train.availableSeats))
    {
        (void)printf("\n=================================\n");
        (void)printf("BOOKING FAILED\n");
        (void)printf("Requested Seats : %d\n", passengerCount);
        (void)printf("Available Seats : %d\n", train.availableSeats);
        (void)printf("Only %d Seats Available\n", train.availableSeats);
        (void)printf("=================================\n");
        (void)fclose(fp);
        return;
    }

    passengers = (Passenger *)malloc(sizeof(Passenger) * (size_t)passengerCount);
    if (passengers == NULL)
    {
        (void)printf("Memory Allocation Failed\n");
        (void)fclose(fp);
        return;
    }

    pnr = generatePNR();
    (void)printf("\nGenerated PNR : %d\n", pnr);

    for (i = 0; i < passengerCount; i++)
    {
        (void)printf("\n====================\n");
        (void)printf("Passenger %d\n", i + 1);
        (void)printf("====================\n");
        (void)printf("Name : ");
        if (scanf(" %49[^\n]", passengers[i].name) != 1)
        {
            passengers[i].name[0] = '\0';
        }
        (void)printf("Age : ");
        if (scanf("%d", &passengers[i].age) != 1)
        {
            passengers[i].age = 0;
        }
        (void)printf("Gender : ");
        if (scanf("%19s", passengers[i].gender) != 1)
        {
            passengers[i].gender[0] = '\0';
        }

        if (passengers[i].age <= 10)
        {
            (void)strncpy(passengers[i].category, "Child", sizeof(passengers[i].category) - 1U);
        }
        else
        {
            (void)strncpy(passengers[i].category, "Adult", sizeof(passengers[i].category) - 1U);
        }
        passengers[i].category[sizeof(passengers[i].category) - 1U] = '\0';

        if (train.availableSeats == 0)
        {
            FILE *wf;

            wf = fopen(WAITLIST_FILE, "a");
            if (wf == NULL)
            {
                (void)printf("Waitlist File Error\n");
                continue;
            }
            (void)fprintf(wf, "%d|%s|%d|%s|%s|%d|%s|%s|%s|%s|%s|%d|%s|WAITLIST\n",
                          pnr, passengers[i].name, passengers[i].age,
                          passengers[i].gender, passengers[i].category,
                          train.trainNo, train.trainName, source, destination,
                          train.departure, train.arrival, train.platform,
                          journeyDate);
            (void)fclose(wf);
            waitlistCount++;
            (void)printf("%s Added To WAITLIST\n", passengers[i].name);
            continue;
        }

        allocateSeat(passengers[i].seatNo);
        totalFare += calculateFare(passengers[i].age);

        (void)fprintf(fp, "%d|%s|%d|%s|%s|%d|%s|%s|%s|%s|%s|%d|%s|%s|PAYMENT_PENDING\n",
                      pnr, passengers[i].name, passengers[i].age,
                      passengers[i].gender, passengers[i].category,
                      train.trainNo, train.trainName, source, destination,
                      train.departure, train.arrival, train.platform,
                      journeyDate, passengers[i].seatNo);
        (void)fflush(fp); /* make this record visible to seatExists() before
                              the next passenger in this same booking is
                              allocated a seat, otherwise two passengers in
                              one transaction can collide on the same seat */

        train.availableSeats--;
        bookedSeats++;
        confirmedCount++;
    }

    (void)fclose(fp);

    if (bookedSeats > 0)
    {
        decreaseSeats(train.trainNo, bookedSeats);
    }

    (void)printf("\n=================================\n");
    (void)printf("BOOKING SUMMARY\n");
    (void)printf("=================================\n");
    (void)printf("PNR Number : %d\n", pnr);
    (void)printf("Confirmed Passengers : %d\n", confirmedCount);
    (void)printf("Waitlist Passengers : %d\n", waitlistCount);
    (void)printf("Total Fare : %.2f\n", (double)totalFare);
    (void)printf("=================================\n");

    logBooking(pnr);
    free(passengers);
}

