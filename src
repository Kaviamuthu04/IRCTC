/* mkdirIfMissing: create a directory with 0755 permissions.
 * Treats "already exists" as success (idempotent bootstrap). */
static int mkdirIfMissing(const char *path)
{
    int result;

    result = mkdir(path, 0755);
    if ((result != 0) && (errno != EEXIST))
    {
        (void)fprintf(stderr,
                      "ERROR: could not create directory '%s'\n",
                      path);
        return -1;
    }
    return 0;
}

int bootstrapDirectories(void)
{
    int status = 0;

    if (mkdirIfMissing(DATA_DIR) != 0)
    {
        status = -1;
    }
    if (mkdirIfMissing(LOG_DIR) != 0)
    {
        status = -1;
    }
    if (mkdirIfMissing(REPORT_DIR) != 0)
    {
        status = -1;
    }
    return status;
}





