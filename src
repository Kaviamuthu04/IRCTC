    }

    while (fscanf(fp, "%49[^|]|%99[^|]|%14[^|]|%49[^\n]\n",
                  user.username, user.email, user.phone, user.password) == 4)
    {
        int idMatches = (strcmp(input, user.username) == 0) ||
                        (strcmp(input, user.email) == 0) ||
                        (strcmp(input, user.phone) == 0);

        if ((idMatches != 0) && (strcmp(password, user.password) == 0))
        {
            time_t now;
            struct tm tmResult;
            char timeBuf[64];

            (void)fclose(fp);
            (void)printf("\nLogin Successful\n");
            (void)printf("Welcome %s\n", user.username);
