#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <pthread.h>
#include "memory_manager.h"
#include "logger.h"
#include "app_config.h"
#include "stress_test.h"

#define USER_MEMORY_KB       50
#define MAX_STRESS_USERS  20000  /* sane upper bound to stop fat-finger DoS on the host */

static int successfulBookings;
static int waitlistBookings;
static long totalAllocatedMemoryKb;
static long totalFreedMemoryKb;
static pthread_mutex_t counterLock;

static void sleepMillis(long milliseconds)
{
    struct timespec ts;

    ts.tv_sec = milliseconds / 1000;
    ts.tv_nsec = (milliseconds % 1000) * 1000000L;
    (void)nanosleep(&ts, NULL);
}

static void *stressUser(void *arg)
{
    int id;
    char *buffer;
    int bookingResult;

    id = *(int *)arg;
    (void)printf("User %d Booking Started\n", id);

    buffer = (char *)memoryAllocate((size_t)USER_MEMORY_KB * 1024U);
    if (buffer != NULL)
    {
        memset(buffer, 0, (size_t)USER_MEMORY_KB * 1024U);
        (void)pthread_mutex_lock(&counterLock);
        totalAllocatedMemoryKb += USER_MEMORY_KB;
        (void)pthread_mutex_unlock(&counterLock);
    }

    sleepMillis(20);

    bookingResult = rand() % 100;
    (void)pthread_mutex_lock(&counterLock);
    if (bookingResult < 80)
    {
        successfulBookings++;
    }
    else
    {
        waitlistBookings++;
    }
    (void)pthread_mutex_unlock(&counterLock);

    if (buffer != NULL)
    {
        memoryRelease(buffer);
        (void)pthread_mutex_lock(&counterLock);
        totalFreedMemoryKb += USER_MEMORY_KB;
        (void)pthread_mutex_unlock(&counterLock);
    }

    (void)printf("User %d Booking Completed\n", id);
    return NULL;
}

static void writeStressLog(int users, double executionTime,
                            long memBeforeKb, long memAfterKb, long memoryLeakKb)
{
    FILE *fp;

    fp = fopen(STRESS_LOG_FILE, "a");
    if (fp == NULL)
    {
        return;
    }
    (void)fprintf(fp, "\n=================================\n");
    (void)fprintf(fp, "STRESS TEST REPORT\n");
    (void)fprintf(fp, "=================================\n");
    (void)fprintf(fp, "Total Users : %d\n", users);
    (void)fprintf(fp, "Successful Booking : %d\n", successfulBookings);
    (void)fprintf(fp, "Waitlist Requests : %d\n", waitlistBookings);
    (void)fprintf(fp, "Execution Time : %.3f Seconds\n", executionTime);
    (void)fprintf(fp, "Memory Before : %ld KB\n", memBeforeKb);
    (void)fprintf(fp, "Memory After : %ld KB\n", memAfterKb);
    (void)fprintf(fp, "Memory Per User : %d KB\n", USER_MEMORY_KB);
    (void)fprintf(fp, "Total Memory Allocated : %ld KB\n", totalAllocatedMemoryKb);
    (void)fprintf(fp, "Total Memory Freed : %ld KB\n", totalFreedMemoryKb);
    (void)fprintf(fp, "Memory Leak (accounting) : %ld KB\n", memoryLeakKb);
    (void)fclose(fp);
}

void runStressTest(void)
{
    int users = 0;
    pthread_t *threads;
    int *ids;
    long memoryBeforeKb;
    long memoryAfterKb;
    long memoryLeakKb;
    struct timespec startTs;
    struct timespec endTs;
    double executionTime;
    int i;
    int mutexReady = 0;

    successfulBookings = 0;
    waitlistBookings = 0;
    totalAllocatedMemoryKb = 0;
    totalFreedMemoryKb = 0;

    (void)printf("\n===== STRESS TEST =====\n");
    (void)printf("Enter Number Of Users : ");
    if (scanf("%d", &users) != 1)
    {
        (void)printf("Invalid Input\n");
        return;
    }
    if ((users <= 0) || (users > MAX_STRESS_USERS))
    {
        (void)printf("Invalid User Count (must be 1-%d)\n", MAX_STRESS_USERS);
        return;
    }

    srand((unsigned int)time(NULL));

    if (pthread_mutex_init(&counterLock, NULL) != 0)
    {
        (void)printf("Failed To Initialise Mutex\n");
        return;
    }
    mutexReady = 1;

    threads = (pthread_t *)memoryAllocate(sizeof(pthread_t) * (size_t)users);
    ids = (int *)memoryAllocate(sizeof(int) * (size_t)users);
    if ((threads == NULL) || (ids == NULL))
    {
        (void)printf("Memory Allocation Failed\n");
        memoryRelease(threads);
        memoryRelease(ids);
        if (mutexReady != 0)
        {
            (void)pthread_mutex_destroy(&counterLock);
        }
        return;
    }

    memoryBeforeKb = getAvailableMemoryKb();
    (void)clock_gettime(CLOCK_MONOTONIC, &startTs);

    for (i = 0; i < users; i++)
    {
        ids[i] = i + 1;
        if (pthread_create(&threads[i], NULL, stressUser, &ids[i]) != 0)
        {
            (void)fprintf(stderr, "WARNING: failed to spawn thread for user %d\n", ids[i]);
            ids[i] = -1; /* mark: no join needed */
        }
    }
    for (i = 0; i < users; i++)
    {
        if (ids[i] != -1)
        {
            (void)pthread_join(threads[i], NULL);
        }
    }

    (void)clock_gettime(CLOCK_MONOTONIC, &endTs);
    executionTime = (double)(endTs.tv_sec - startTs.tv_sec) +
                    ((double)(endTs.tv_nsec - startTs.tv_nsec) / 1e9);

    memoryAfterKb = getAvailableMemoryKb();
    memoryLeakKb = totalAllocatedMemoryKb - totalFreedMemoryKb;

    if ((memoryAfterKb >= 0) && (memoryAfterKb < MEMORY_WARNING))
    {
        logOOMEvent();
    }

    writeStressLog(users, executionTime, memoryBeforeKb, memoryAfterKb, memoryLeakKb);

    (void)printf("\n=================================\n");
    (void)printf("STRESS TEST REPORT\n");
    (void)printf("=================================\n\n");
    (void)printf("Total Users                 : %d\n", users);
    (void)printf("Successful Booking          : %d\n", successfulBookings);
    (void)printf("Waitlist Requests           : %d\n", waitlistBookings);
    (void)printf("Execution Time              : %.3f Seconds\n", executionTime);
    (void)printf("Memory Before                : %ld KB\n", memoryBeforeKb);
    (void)printf("Memory Per User             : %d KB\n", USER_MEMORY_KB);
    (void)printf("Total Memory Allocated      : %ld KB\n", totalAllocatedMemoryKb);
    (void)printf("Total Memory Freed          : %ld KB\n", totalFreedMemoryKb);
    (void)printf("Memory After                : %ld KB\n", memoryAfterKb);
    (void)printf("Memory Leak (accounting)    : %ld KB\n", memoryLeakKb);
    (void)printf("Leak Status                 : %s\n",
                 (memoryLeakKb == 0) ? "NO MEMORY LEAK" : "MEMORY LEAK DETECTED");
    (void)printf("Status                      : %s\n",
                 (memoryLeakKb == 0) ? "PASSED" : "FAILED");
    (void)printf("=================================\n");

    (void)pthread_mutex_destroy(&counterLock);
    memoryRelease(threads);
    memoryRelease(ids);
}



