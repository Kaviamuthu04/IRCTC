    }
    (void)fclose(fp);
}

/* Rewrites one reservation record that matches pnr from PAYMENT_PENDING
 * to CONFIRMED, writing everything else through unchanged. Returns 1 if
 * the record was found and updated, 0 otherwise. Field layout must stay
 * in sync with reservation.c's bookTicket()/cancelTicket() writers. */
static int rewriteReservationsForPayment(int pnr, int *adultCount,
                                          int *childCount, float *totalAmount)
{
    FILE *fp;
    FILE *temp;
    char line[500];
    int found = 0;

    fp = fopen(RESERVATION_FILE, "r");
    if (fp == NULL)
    {
        (void)printf("Reservation File Not Found\n");
        return 0;
    }
    temp = fopen(RESERVATION_TMP_FILE, "w");
    if (temp == NULL)
    {
        (void)fclose(fp);
        return 0;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        int filePNR;
        char name[50];
        int age;
        char gender[20];
        char category[20];
        int trainNo;
        int platform;
        char trainName[50];
        char source[50];
        char destination[50];
        char departure[20];
        char arrival[20];
        char journeyDate[20];
        char seatNo[20];
        char status[30];
        int fields;

        fields = sscanf(line,
            "%d|%49[^|]|%d|%19[^|]|%19[^|]|%d|%49[^|]|%49[^|]|%49[^|]|%19[^|]|%19[^|]|%d|%19[^|]|%19[^|]|%29[^\n]",
            &filePNR, name, &age, gender, category, &trainNo, trainName,
            source, destination, departure, arrival, &platform,
            journeyDate, seatNo, status);

        if ((fields != 15) || (filePNR != pnr))
        {
            (void)fputs(line, temp);
            continue;
        }

        found = 1;
        if (strcmp(status, "PAYMENT_PENDING") != 0)
        {
            (void)printf("\nPayment Not Required\n");
            (void)printf("Current Status : %s\n", status);
            (void)fputs(line, temp);
            continue;
        }

        if (age <= CHILD_AGE_LIMIT)
        {
            (*childCount)++;
            *totalAmount += (float)CHILD_FARE;
        }
        else
        {
            (*adultCount)++;
            *totalAmount += (float)ADULT_FARE;
        }

        (void)fprintf(temp, "%d|%s|%d|%s|%s|%d|%s|%s|%s|%s|%s|%d|%s|%s|CONFIRMED\n",
                      filePNR, name, age, gender, category, trainNo, trainName,
                      source, destination, departure, arrival, platform,
                      journeyDate, seatNo);

        (void)printf("\n=================================\n");
        (void)printf("PAYMENT SUCCESSFUL\n");
        (void)printf("PNR Number : %d\n", filePNR);
        (void)printf("Amount     : %.2f\n", (age <= CHILD_AGE_LIMIT) ? CHILD_FARE : ADULT_FARE);
        (void)printf("Seat No    : %s\n", seatNo);
        (void)printf("Status     : CONFIRMED\n");
        (void)printf("=================================\n");

        (void)printf("\n=================================\n");
