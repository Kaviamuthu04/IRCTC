}

float calculateRefund(float fare)
{
    float refund;

    refund = fare - (float)CANCELLATION_FEE;
    if (refund < 0.0f)
    {
        refund = 0.0f;
    }
    return refund;
}

void updatePaymentStatus(int pnr)
{
    FILE *fp;
    FILE *temp;
    char line[500];
    int filePNR;

    fp = fopen(PAYMENT_FILE, "r");
    if (fp == NULL)
    {
        return;
    }
    temp = fopen(PAYMENT_TMP_FILE, "w");
    if (temp == NULL)
    {
        (void)fclose(fp);
        return;
    }

    while (fgets(line, sizeof(line), fp) != NULL)
    {
        if (sscanf(line, "%d|", &filePNR) == 1)
        {
            if (filePNR == pnr)
            {
                char paymentMethod[50];
                float amount;

                if (sscanf(line, "%d|%f|%49[^|]", &filePNR, &amount, paymentMethod) == 3)
                {
                    (void)fprintf(temp, "%d|%.2f|%s|REFUNDED\n", filePNR, (double)amount, paymentMethod);
                    continue;
                }
            }
        }
        (void)fputs(line, temp);
    }
    (void)fclose(fp);
    (void)fclose(temp);
    (void)remove(PAYMENT_FILE);
    (void)rename(PAYMENT_TMP_FILE, PAYMENT_FILE);
}

