(); break;
            case 16: viewNotifications(); break;
            case 17: partialCancellation(); break;
            case 18:
            {
                long freeMemoryKb;

                freeMemoryKb = getAvailableMemoryKb();
                (void)printf("\n===== OOM QUICK CHECK =====\n");
                (void)printf("Available Memory : %ld KB\n", freeMemoryKb);
                if ((freeMemoryKb >= 0) && (freeMemoryKb < MEMORY_WARNING))
                {
                    (void)printf("WARNING : MEMORY PRESSURE DETECTED\n");
                    logOOMEvent();
                    addUserToQueue("BOOKING_REQUEST");
                }
                else
                {
                    (void)printf("Memory Status : HEALTHY\n");
                }
                break;
            }
            case 19: showOOMDashboard(); break;
            case 20: runOOMAnalysis(); break;
            case 21: viewUsers(); break;
            case 22:
                (void)printf("Exiting Application...\n");
                running = 0;
                break;
            default:
                (void)printf("Invalid Choice! Please Try Again.\n");
                break;
        }
    }

    return 0;
}



