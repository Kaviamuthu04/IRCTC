                (void)strftime(timeBuf, sizeof(timeBuf), "%Y-%m-%d %H:%M:%S", &tmResult);

                (void)fprintf(logfp, "\n=====================\n");
                (void)fprintf(logfp, "Username   : %s\n", user.username);
                (void)fprintf(logfp, "Email      : %s\n", user.email);
                (void)fprintf(logfp, "Phone      : %s\n", user.phone);
                (void)fprintf(logfp, "Login Time : %s\n", timeBuf);
                (void)fprintf(logfp, "=====================\n");
                (void)fclose(logfp);
            }
            return 1;
        }
    }
    (void)fclose(fp);
    (void)printf("\nInvalid Credentials\n");
    return 0;
}

void forgotPassword(void)
{
    char input[100];
    char newPassword[PASSWORD_LEN];
    StoredUser user;
