    {
        (void)fclose(fp);
        (void)fclose(temp);
        (void)remove(TRAIN_TMP_FILE);
        return;
    }
    (void)printf("New Platform Number: ");
    if (scanf("%d", &newPlatform) != 1)
    {
        (void)fclose(fp);
        (void)fclose(temp);
        (void)remove(TRAIN_TMP_FILE);
        return;
    }

    while (fscanf(fp, "%d|%49[^|]|%49[^|]|%49[^|]|%19[^|]|%19[^|]|%d|%d|%d\n",
                  &t.trainNo, t.trainName, t.source, t.destination,
                  t.departure, t.arrival, &t.platform,
                  &t.totalSeats, &t.availableSeats) == 9)
    {
        if (t.trainNo == targetTrainNo)
        {
            (void)strncpy(t.departure, newDeparture, sizeof(t.departure) - 1U);
            t.departure[sizeof(t.departure) - 1U] = '\0';
            (void)strncpy(t.arrival, newArrival, sizeof(t.arrival) - 1U);
            t.arrival[sizeof(t.arrival) - 1U] = '\0';
            t.platform = newPlatform;
            found = 1;
        }
        (void)fprintf(temp, "%d|%s|%s|%s|%s|%s|%d|%d|%d\n",
                      t.trainNo, t.trainName, t.source, t.destination,
                      t.departure, t.arrival, t.platform,
                      t.totalSeats, t.availableSeats);
    }
    (void)fclose(fp);
    (void)fclose(temp);
    (void)remove(TRAIN_FILE);
    (void)rename(TRAIN_TMP_FILE, TRAIN_FILE);

    if (found != 0)
    {
        (void)printf("Schedule Updated Successfully\n");
    }
    else
    {
        (void)printf("Train Not Found\n");
    }
}


