int isJourneyExpired(const char *travelDate)
{
    int day = 0;
    int month = 0;
    int year = 0;
    time_t t;
    struct tm current;
    int currentDay;
    int currentMonth;
    int currentYear;

    if (travelDate == NULL)
    {
        return 1; /* fail safe: unknown date treated as expired */
    }

    (void)sscanf(travelDate, "%d-%d-%d", &day, &month, &year);

    t = time(NULL);
    (void)localtime_r(&t, &current);
    currentDay = current.tm_mday;
    currentMonth = current.tm_mon + 1;
    currentYear = current.tm_year + 1900;

    if (year < currentYear)
    {
        return 1;
    }
    if ((year == currentYear) && (month < currentMonth))
    {
        return 1;
    }
    if ((year == currentYear) && (month == currentMonth) && (day < currentDay))
    {
        return 1;
    }
    return 0;
}

