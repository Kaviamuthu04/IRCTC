static void readLine(char *buffer, size_t size)
{
    if (fgets(buffer, (int)size, stdin) != NULL)
    {
        buffer[strcspn(buffer, "\n")] = '\0';
    }
    else
    {
        buffer[0] = '\0';
    }
}

static void flushStdinLine(void)
{
    int c;

    while (((c = getchar()) != '\n') && (c != EOF))
    {
        /* discard */
    }
}

void addTrain(void)
{
    Train t;
    FILE *fp;

    memset(&t, 0, sizeof(t));

    (void)printf("\n===== ADD TRAIN =====\n");
    (void)printf("Train Number: ");
    if (scanf("%d", &t.trainNo) != 1)
    {
        (void)printf("Invalid Input\n");
        flushStdinLine();
        return;
    }
    flushStdinLine();

    (void)printf("Train Name: ");
    readLine(t.trainName, sizeof(t.trainName));
    (void)printf("Source: ");
    readLine(t.source, sizeof(t.source));
    (void)printf("Destination: ");
    readLine(t.destination, sizeof(t.destination));
    (void)printf("Departure Time: ");
    readLine(t.departure, sizeof(t.departure));
    (void)printf("Arrival Time: ");
    readLine(t.arrival, sizeof(t.arrival));

    (void)printf("Platform Number: ");
    if (scanf("%d", &t.platform) != 1)
    {
        (void)printf("Invalid Input\n");
        flushStdinLine();
        return;
    }
    (void)printf("Total Seats: ");
    if (scanf("%d", &t.totalSeats) != 1)
    {
        (void)printf("Invalid Input\n");
        flushStdinLine();
        return;
    }
    flushStdinLine();
    t.availableSeats = t.totalSeats;

